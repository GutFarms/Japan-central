# Personal Cursor user API key from https://cursor.com/dashboard/api
# My Machines requires a personal credential (not a service-account key).
CURSOR_API_KEY=

# Display name shown in cursor.com/agents environment dropdown
CURSOR_APPLIANCE_NAME=cursor-appliance

# Local management HTTP bind for /healthz /readyz /metrics
CURSOR_APPLIANCE_MANAGEMENT_ADDR=127.0.0.1:8733

# Optional: absolute path to the git checkout the worker should expose.
# Defaults to the Japan-central repo root (parent of cursor-appliance/).
# CURSOR_APPLIANCE_WORKER_DIR=

# Seconds the worker may stay connected after becoming idle before exit.
# 0 keeps a dedicated appliance online until you stop it (recommended).
CURSOR_APPLIANCE_IDLE_RELEASE_TIMEOUT=0

# Optional proxy
# HTTPS_PROXY=
# https_proxy=
