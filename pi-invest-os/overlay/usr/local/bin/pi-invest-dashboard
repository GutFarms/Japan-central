#!/usr/bin/env bash
# Open the local Pi Invest web dashboard in a browser.
# Menu name: "Pi Invest Dashboard"  |  CLI: pi-invest-dashboard
set -euo pipefail

URL="${PI_INVEST_KIOSK_URL:-http://127.0.0.1:8787}"
ENV_FILE=/opt/pi-invest-agent/.env
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE" || true
  set +a
  URL="${PI_INVEST_KIOSK_URL:-$URL}"
fi

start_dashboard_service() {
  if systemctl is-active --quiet pi-invest-dashboard.service 2>/dev/null; then
    return 0
  fi
  # Passwordless via /etc/sudoers.d/pi-invest-dashboard when present
  if sudo -n /usr/bin/systemctl start pi-invest-dashboard.service 2>/dev/null; then
    return 0
  fi
  if command -v pkexec >/dev/null 2>&1; then
    pkexec /usr/bin/systemctl start pi-invest-dashboard.service 2>/dev/null || true
  fi
}

healthy() {
  curl -fsS --max-time 2 "$URL/api/health" >/dev/null 2>&1 \
    || curl -fsS --max-time 2 "$URL" >/dev/null 2>&1
}

if ! healthy; then
  start_dashboard_service || true
  for _ in $(seq 1 45); do
    healthy && break
    sleep 1
  done
fi

if ! healthy; then
  MSG="Dashboard is not responding at ${URL}.\nTry: sudo systemctl start pi-invest-dashboard"
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="Pi Invest Dashboard" --text="$MSG" || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "Pi Invest Dashboard" "$MSG" || true
  else
    echo "ERROR: $MSG" >&2
  fi
  # Still try to open the URL so the user sees the browser error page
fi

pick_browser() {
  local c
  for c in chromium chromium-browser firefox-esr firefox xdg-open; do
    command -v "$c" >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}

BROWSER="$(pick_browser)" || {
  echo "ERROR: no web browser installed (need chromium)" >&2
  exit 1
}

case "$BROWSER" in
  chromium|chromium-browser)
    exec "$BROWSER" --new-window --app="$URL" --no-first-run \
      --disable-session-crashed-bubble --check-for-update-interval=31536000
    ;;
  firefox|firefox-esr)
    exec "$BROWSER" --new-window "$URL"
    ;;
  *)
    exec "$BROWSER" "$URL"
    ;;
esac
