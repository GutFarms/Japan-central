[Unit]
Description=Pi Invest Agent — autonomous income trader
After=network-online.target pi-invest-firstboot.service
Wants=network-online.target
ConditionPathExists=/var/lib/pi-invest/firstboot-done

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/pi-invest-agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/pi-invest-agent/.env
ExecStart=/opt/pi-invest-agent/.venv/bin/pi-invest run
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
